{
  "name": "student-notes-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB Atlas + AWS S3 backend for the Cloud-Based Student Notes Repository",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/check-config.js",
    "import-s3": "node scripts/import-s3.js",
    "make-admin": "node scripts/make-admin.js",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "s3rver": "^3.7.1",
    "supertest": "^7.0.0"
  }
}
